#!/bin/bash
# Cloud env for xq.xmls.vip — chmod 600 this file on the server.
# PostgreSQL / Redis ports & passwords match bj.xmls.vip (same Docker mappings).

export APP_HOME="${APP_HOME:-/www/wwwroot/xq.xmls.vip}"
export DOMAIN="${DOMAIN:-xq.xmls.vip}"
export SERVER_PORT="${SERVER_PORT:-9093}"

# PostgreSQL (same host port / password as bj.xmls.vip; separate database)
export DB_HOST="${DB_HOST:-127.0.0.1}"
export DB_PORT="${DB_PORT:-35432}"
export DB_NAME="${DB_NAME:-spas_sql}"
export DB_USERNAME="${DB_USERNAME:-postgres}"
export DB_PASSWORD="${DB_PASSWORD:-CHANGE_ME}"
export DB_URL="jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}?stringtype=unspecified&TimeZone=Asia/Shanghai"
export PGPASSWORD="${DB_PASSWORD}"

# RuoYi / SPAS datasource env aliases
export SPAS_DB_URL="${SPAS_DB_URL:-${DB_URL}}"
export SPAS_DB_USER="${SPAS_DB_USER:-${DB_USERNAME}}"
export SPAS_DB_PASSWORD="${SPAS_DB_PASSWORD:-${DB_PASSWORD}}"

# Docker PostgreSQL container (from: docker ps). Same instance as bj.xmls.vip.
export PG_DOCKER_CONTAINER="${PG_DOCKER_CONTAINER:-postgresql_18_p5mm-postgresql_18_p5mm-1}"

# Redis (same host port / password as bj.xmls.vip; DB index 1 to avoid key clash)
export REDIS_HOST="${REDIS_HOST:-127.0.0.1}"
export REDIS_PORT="${REDIS_PORT:-26739}"
export REDIS_PASSWORD="${REDIS_PASSWORD:-CHANGE_ME}"
export REDIS_DB="${REDIS_DB:-1}"

# Security
export TOKEN_SECRET="${TOKEN_SECRET:-CHANGE_ME_TOKEN_SECRET}"
export TOKEN_EXPIRE_MINUTES="${TOKEN_EXPIRE_MINUTES:-480}"
export SPAS_DRUID_STAT_ENABLED="${SPAS_DRUID_STAT_ENABLED:-false}"
export SPAS_DRUID_PASSWORD="${SPAS_DRUID_PASSWORD:-CHANGE_ME}"

# Paths / JVM
export RUOYI_PROFILE="${RUOYI_PROFILE:-}"
export JAVA_OPTS="${JAVA_OPTS:--Xms512m -Xmx1024m -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai}"
export SPRING_PROFILES_ACTIVE="${SPRING_PROFILES_ACTIVE:-druid,prod}"

export PATH="/www/server/pgsql/bin:/usr/pgsql-16/bin:/usr/pgsql-15/bin:/usr/local/pgsql/bin:${PATH}"
