<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.spas.mapper.SpasTeacherDeptMapper">

    <select id="selectDeptIdsByTeacherId" resultType="long">
        select dept_id from spas_teacher_dept where teacher_id = #{teacherId} order by dept_id
    </select>

    <delete id="deleteByTeacherId">
        delete from spas_teacher_dept where teacher_id = #{teacherId}
    </delete>

    <insert id="insertTeacherDept">
        insert into spas_teacher_dept(teacher_id, dept_id) values (#{teacherId}, #{deptId})
    </insert>

</mapper>
