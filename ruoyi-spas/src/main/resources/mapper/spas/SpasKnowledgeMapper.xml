<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.spas.mapper.SpasKnowledgeMapper">

    <resultMap type="SpasKnowledge" id="SpasKnowledgeResult">
        <id     property="knowledgeId"       column="knowledge_id"       />
        <result property="subjectId"         column="subject_id"         />
        <result property="parentId"          column="parent_id"          />
        <result property="ancestors"         column="ancestors"          />
        <result property="knowledgeName"     column="knowledge_name"     />
        <result property="knowledgeCode"     column="knowledge_code"     />
        <result property="difficultyDefault" column="difficulty_default" />
        <result property="nodeType"          column="node_type"          />
        <result property="orderNum"          column="order_num"          />
        <result property="status"            column="status"             />
        <result property="parentName"        column="parent_name"        />
        <result property="createBy"          column="create_by"          />
        <result property="createTime"        column="create_time"        />
        <result property="updateBy"          column="update_by"          />
        <result property="updateTime"        column="update_time"        />
        <result property="remark"            column="remark"             />
    </resultMap>

    <sql id="selectSpasKnowledgeVo">
        select k.knowledge_id, k.subject_id, k.parent_id, k.ancestors, k.knowledge_name,
               k.knowledge_code, k.difficulty_default, k.node_type, k.order_num, k.status,
               k.create_by, k.create_time, k.update_by, k.update_time, k.remark,
               p.knowledge_name as parent_name
        from spas_knowledge k
        left join spas_knowledge p on p.knowledge_id = k.parent_id
    </sql>

    <select id="selectSpasKnowledgeList" parameterType="SpasKnowledge" resultMap="SpasKnowledgeResult">
        <include refid="selectSpasKnowledgeVo"/>
        <where>
            <if test="subjectId != null">
                AND k.subject_id = #{subjectId}
            </if>
            <if test="parentId != null">
                AND (k.parent_id = #{parentId}
                     OR cast(#{parentId} as varchar) = any(string_to_array(k.ancestors, ',')))
            </if>
            <if test="knowledgeName != null and knowledgeName != ''">
                AND k.knowledge_name like concat('%', #{knowledgeName,jdbcType=VARCHAR}, '%')
            </if>
            <if test="knowledgeCode != null and knowledgeCode != ''">
                AND k.knowledge_code like concat('%', #{knowledgeCode,jdbcType=VARCHAR}, '%')
            </if>
            <if test="status != null and status != ''">
                AND k.status = #{status}
            </if>
            <if test="nodeType != null and nodeType != ''">
                AND k.node_type = #{nodeType}
            </if>
        </where>
        order by k.order_num asc, k.knowledge_id asc
    </select>

    <select id="selectSpasKnowledgeById" parameterType="Long" resultMap="SpasKnowledgeResult">
        <include refid="selectSpasKnowledgeVo"/>
        where k.knowledge_id = #{knowledgeId}
    </select>

    <select id="selectSpasKnowledgeBySubjectId" parameterType="Long" resultMap="SpasKnowledgeResult">
        <include refid="selectSpasKnowledgeVo"/>
        where k.subject_id = #{subjectId}
        order by k.order_num asc, k.knowledge_id asc
    </select>

    <select id="hasChildByKnowledgeId" parameterType="Long" resultType="int">
        select count(1) from spas_knowledge where parent_id = #{knowledgeId} limit 1
    </select>

    <select id="countQuestionKnowledgeByKnowledgeId" parameterType="Long" resultType="int">
        select count(1) from spas_question_knowledge where knowledge_id = #{knowledgeId}
    </select>

    <select id="selectChildrenKnowledgeById" parameterType="Long" resultMap="SpasKnowledgeResult">
        select * from spas_knowledge
        where cast(#{knowledgeId} as varchar) = any(string_to_array(ancestors, ','))
    </select>

    <insert id="insertSpasKnowledge" parameterType="SpasKnowledge" useGeneratedKeys="true" keyProperty="knowledgeId">
        insert into spas_knowledge(
            <if test="subjectId != null">subject_id,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="ancestors != null and ancestors != ''">ancestors,</if>
            <if test="knowledgeName != null and knowledgeName != ''">knowledge_name,</if>
            <if test="knowledgeCode != null and knowledgeCode != ''">knowledge_code,</if>
            <if test="difficultyDefault != null and difficultyDefault != ''">difficulty_default,</if>
            <if test="nodeType != null and nodeType != ''">node_type,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="remark != null and remark != ''">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            <if test="subjectId != null">#{subjectId},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="ancestors != null and ancestors != ''">#{ancestors},</if>
            <if test="knowledgeName != null and knowledgeName != ''">#{knowledgeName},</if>
            <if test="knowledgeCode != null and knowledgeCode != ''">#{knowledgeCode},</if>
            <if test="difficultyDefault != null and difficultyDefault != ''">#{difficultyDefault},</if>
            <if test="nodeType != null and nodeType != ''">#{nodeType},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="remark != null and remark != ''">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            now()
        )
    </insert>

    <update id="updateSpasKnowledge" parameterType="SpasKnowledge">
        update spas_knowledge
        <set>
            <if test="subjectId != null">subject_id = #{subjectId},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="ancestors != null and ancestors != ''">ancestors = #{ancestors},</if>
            <if test="knowledgeName != null and knowledgeName != ''">knowledge_name = #{knowledgeName},</if>
            <if test="knowledgeCode != null">knowledge_code = #{knowledgeCode},</if>
            <if test="difficultyDefault != null and difficultyDefault != ''">difficulty_default = #{difficultyDefault},</if>
            <if test="nodeType != null and nodeType != ''">node_type = #{nodeType},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = now()
        </set>
        where knowledge_id = #{knowledgeId}
    </update>

    <update id="updateKnowledgeChildren" parameterType="java.util.List">
        update spas_knowledge set ancestors =
        <foreach collection="knowledges" item="item" index="index" separator=" " open="case knowledge_id" close="end">
            when #{item.knowledgeId} then #{item.ancestors}
        </foreach>
        where knowledge_id in
        <foreach collection="knowledges" item="item" open="(" separator="," close=")">
            #{item.knowledgeId}
        </foreach>
    </update>

    <delete id="deleteSpasKnowledgeById" parameterType="Long">
        delete from spas_knowledge where knowledge_id = #{knowledgeId}
    </delete>

</mapper>
